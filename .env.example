# Copy to .env.local. Never commit real keys.
DEMO_MODE=1
ANTHROPIC_API_KEY=
DIAL_API_KEY=
DIAL_BASE_URL=https://api.getdial.ai/api/v1
DIAL_FROM_NUMBER_ID=      # number A: our buyer/procurement agent
DIAL_VENDOR_NUMBER_ID=    # number B: AI vendor agent (inboundInstruction set per call)
DIAL_VENDOR_PHONE=        # number B in E.164
VENDOR_MODE=ai            # ai | human
CERTLY_PHONE=   # teammate's phone (E.164), answers as Certly test vendor
VANTLY_PHONE=   # Cindy's phone (E.164), answers as Vantly test vendor
KEEWANO_EVENT_KEY=
KEEWANO_PAT=
KEEWANO_PROJECT_ID=
AUTO_NEGOTIATE=off          # off | replay | live — marketplace auto-starts vendor calls when pool is big enough
AUTO_NEGOTIATE_MIN_BUYERS=10
HUMAN_VENDOR_ID=            # optional: one vendor answered by a real person on <VENDOR>_PHONE
HACK_VENDOR_PHONE=          # optional: number the hack/ frontend's one live Dial call dials (defaults to HUMAN_VENDOR_ID's phone)
