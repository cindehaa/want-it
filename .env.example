VENDOR_MODE=ai            # ai | human
CERTLY_PHONE=   # teammate's phone (E.164), answers as Certly test vendor
VANTLY_PHONE=   # Cindy's phone (E.164), answers as Vantly test vendor
KEEWANO_EVENT_KEY=
KEEWANO_PAT=
KEEWANO_PROJECT_ID=
